          <mxGeometry as="geometry" x="740.0" y="100.0" width="460.0" height="160.0" />
        </mxCell>
        <mxCell id="n9" parent="1" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;strokeWidth=1.5;spacing=0;align=center;verticalAlign=middle;labelBackgroundColor=none;fontSize=22;rounded=0;" value="Найти и вывести символ&#10;q = x mod 4096.&#10;Выбрать s: c(s) &lt;= q &lt; c(s) + f(s).&#10;Добавить s к результату." vertex="1">
