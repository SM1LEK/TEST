        <mxCell id="edge-10" edge="1" parent="1" source="n-4" target="n-5" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n-6" value="Выход: CRC[12] | D₀ … D₉ | P₀ | P₁&#10;E(S) = 48 + 12q байт" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
