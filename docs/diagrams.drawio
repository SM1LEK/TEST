          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n-5" value="Собрать D₀ … D₉&#10;Прочитать S из первых 4 байтов&#10;Проверить S ≤ 10q − 4; удалить заполнение" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
