          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="example" value="0x80 × 0x02: z⁷ × z = z⁸&#10;z⁸ ≡ z⁴ + z³ + z² + 1&#10;Результат: 00011101₂ = 0x1D" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
