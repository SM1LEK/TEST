        <mxCell id="byte" value="a = 0x83 = 10000011₂&#10;a(z) = z⁷ + z + 1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
