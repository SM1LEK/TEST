      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="rANS • взаимно обратные переходы, n &gt; 0" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="24" width="1300" height="52" />
        </mxCell>
        <mxCell id="left" value="Кодирование: справа налево" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
