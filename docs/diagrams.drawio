        <mxCell id="multiply" value="Pᵣ[j] = XORₖ (Gₚ[r,k] × Dₖ[j])&#10;Для каждого смещения j фрагментов независимо" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
