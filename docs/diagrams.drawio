          <mxGeometry as="geometry" x="80.0" y="520.0" width="460.0" height="160.0" />
        </mxCell>
        <mxCell id="n5" parent="1" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;strokeWidth=1.5;spacing=0;align=center;verticalAlign=middle;labelBackgroundColor=none;fontSize=22;rounded=0;" value="Закодировать символ&#10;x = floor(x / f(s)) × 4096&#10;+ (x mod f(s)) + c(s)&#10;Повторять шаги 2–4 для всего входа." vertex="1">
          <mxGeometry as="geometry" x="80.0" y="730.0" width="460.0" height="160.0" />
