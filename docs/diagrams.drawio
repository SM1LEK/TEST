          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="inverse" value="Для a ≠ 0: a²⁵⁵ = 1; a⁻¹ = a²⁵⁴&#10;Деление: a / b = a × b⁻¹, b ≠ 0" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
