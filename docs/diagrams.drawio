  <diagram id="reed-solomon" name="reed-solomon">
    <mxGraphModel dx="1120" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1029" background="#1f1e24">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="GF(256) • байт как многочлен над GF(2)" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="24" width="1040" height="52" />
        </mxCell>
        <mxCell id="byte" value="a = 0x83 = 10000011₂&#10;a(z) = z⁷ + z + 1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="120" width="740" height="110" />
        </mxCell>
        <mxCell id="field" value="P(z) = z⁸ + z⁴ + z³ + z² + 1 = 0x11D&#10;Сложение: XOR&#10;Умножение: многочлены modulo P(z)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="300" width="740" height="130" />
        </mxCell>
        <mxCell id="edge-4" edge="1" parent="1" source="byte" target="field" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="example" value="0x80 × 0x02: z⁷ × z = z⁸&#10;z⁸ ≡ z⁴ + z³ + z² + 1&#10;Результат: 00011101₂ = 0x1D = 29" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="520" width="740" height="135" />
        </mxCell>
        <mxCell id="edge-6" edge="1" parent="1" source="field" target="example" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="inverse" value="Для a ≠ 0: a²⁵⁵ = 1; a⁻¹ = a²⁵⁴&#10;Деление: a / b = a × b⁻¹, b ≠ 0" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="750" width="740" height="105" />
        </mxCell>
        <mxCell id="edge-8" edge="1" parent="1" source="example" target="inverse" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note-8" value="Все матричные суммы RS — XOR, все произведения — операции этого поля, не целых чисел." style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="925" width="1040" height="64" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rs-erasure-encode" name="rs-erasure-encode">
    <mxGraphModel dx="1120" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1082" background="#1f1e24">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RS(12,10) • кодирование сохранённого payload" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="24" width="1040" height="52" />
