        <mxCell id="inverse" value="A = [81 96; 96 81] (hex)&#10;A⁻¹ = [BD DB; DB BD] (hex)&#10;[D₀; D₁] = A⁻¹ × [21; 53] = [06; 00] (hex)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
