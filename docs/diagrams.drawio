        <mxCell id="n1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=8;labelBackgroundColor=none;fontColor=#ececef;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=#1f1e24;" value="Подготовить 256 ячеек&#10;Для каждого индекса i от 0 до 255&#10;начать с c = i." vertex="1">
          <mxGeometry height="160" width="460" x="80" y="100" as="geometry"/>
        </mxCell>
        <mxCell id="n2" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=8;labelBackgroundColor=none;fontColor=#ececef;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=#1f1e24;" value="Обработать младший бит&#10;Если c AND 1 = 0: c = c &gt;&gt; 1.&#10;Иначе: c = (c &gt;&gt; 1) XOR 0xEDB88320." vertex="1">
          <mxGeometry height="160" width="460" x="80" y="310" as="geometry"/>
        </mxCell>
        <mxCell id="n3" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=8;labelBackgroundColor=none;fontColor=#ececef;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=#1f1e24;" value="Выполнить восемь шагов&#10;Повторить обработку бита 8 раз&#10;для текущего индекса i." vertex="1">
          <mxGeometry height="160" width="460" x="80" y="520" as="geometry"/>
        </mxCell>
        <mxCell id="n4" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=8;labelBackgroundColor=none;fontColor=#ececef;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=#1f1e24;" value="Сохранить элемент&#10;TABLE[i] = c.&#10;Перейти к следующему индексу." vertex="1">
          <mxGeometry height="160" width="460" x="80" y="730" as="geometry"/>
        </mxCell>
        <mxCell id="n5" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=8;labelBackgroundColor=none;fontColor=#ececef;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=#1f1e24;" value="Получить готовую таблицу&#10;256 значений для отражённого полинома.&#10;Таблица общая для всех расчётов." vertex="1">
          <mxGeometry height="160" width="460" x="80" y="940" as="geometry"/>
        </mxCell>
        <mxCell id="n6" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=8;labelBackgroundColor=none;fontColor=#ececef;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=#1f1e24;" value="Начальный регистр&#10;crc = 0xFFFFFFFF." vertex="1">
