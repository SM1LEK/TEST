  <diagram id="rans-overview" name="rans-overview">
    <mxGraphModel dx="1120" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="974" background="#1f1e24">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="rANS • модель BANAN и интервалы символов" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="24" width="1040" height="52" />
        </mxCell>
        <mxCell id="count" value="Вход: ASCII BANAN; n = 5; D = 3&#10;Число появлений: A = 2, B = 1, N = 2" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="110" width="780" height="100" />
        </mxCell>
        <mxCell id="norm" value="M = 4096; M − D = 4093&#10;f⁰ = (1638, 819, 1638); сумма 4095&#10;Наибольший остаток у B: добавить 1&#10;f = (1638, 820, 1638)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="275" width="780" height="145" />
        </mxCell>
        <mxCell id="edge-4" edge="1" parent="1" source="count" target="norm" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="intervalA" value="A&#10;[0, 1638)&#10;f = 1638" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="520" width="416" height="108" />
        </mxCell>
        <mxCell id="intervalB" value="B&#10;[1638, 2458)&#10;f = 820" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="456" y="520" width="208" height="108" />
        </mxCell>
        <mxCell id="intervalN" value="N&#10;[2458, 4096)&#10;f = 1638" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="664" y="520" width="416" height="108" />
        </mxCell>
        <mxCell id="lookup" value="q = x mod 4096&#10;Выбрать s: c(s) ≤ q &lt; c(s) + f(s)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
