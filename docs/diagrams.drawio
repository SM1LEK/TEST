y relative="1" as="geometry"/></mxCell><mxCell id="e3" value="x = floor(x / f(s)) · M&#10;+ x mod f(s) + c(s)" style="rounded=0;whiteSpace=wrap;fillColor=#1f1e24;strokeColor=#b3afb9;fontFamily=Arial;html=0;fontColor=#ececef;strokeWidth=1.5;shadow=0;gradientColor=none;labelBackgroundColor=none;fontSize=18;align=center;verticalAlign=middle;spacing=8;shape=rectangle;perimeter=rectanglePerimeter;" vertex="1" parent="1"><mxGeometry x="200.0" y="460.0" width="400.0" height="100.0" as="geometry"/></mxCell><mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;fontFamily=Arial;html=0;fontColor=#ececef;strokeWidth=1.5;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=none;labelBackgroundColor=none;fontSize=18;endArrow=block;endFill=1;endSize=8;rounded=0;" edge="1" source="e2" target="e3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dec" value="Декодирование (слева направо)" style="shape=text;fontSize=18;fontStyle=1;fontFamily=Arial;html=0;fontColor=#ececef;strokeWidth=1.5;shadow=0;gradientColor=none;strokeColor=none;fillColor=none;labelBackgroundColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200.0" y="120.0" width="600.0" height="50.0" as="geometry"/></mxCell><mxCell id="d1" value="Прочитать x (4 байта)" style="rounded=0;whiteSpace=wrap;fillColor=#1f1e24;strokeColor=#b3afb9;fontFamily=Arial;html=0;fontColor=#ececef;strokeWidth=1.5;shadow=0;gradientColor=none;labelBackgroundColor=none;fontSize=18;align=center;verticalAlign=middle;spacing=8;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1"><mxGeometry x="1200.0" y="200.0" width="400.0" height="80.0" as="geometry"/></mxCell><mxCell id="d2" value="q = x mod M&#10;Найти s: c(s) ≤ q &lt; c(s) + f(s)" style="rounded=0;whiteSpace=wrap;fillColor=#1f1e24;strokeColor=#b3afb9;fontFamily=Arial;html=0;fontColor=#ececef;strokeWidth=1.5;shadow=0;gradientColor=none;labelBackgroundColor=none;fontSize=18;align=center;verticalAlign=middle;spacing=8;shape=rectangle;perimeter=rectanglePerimeter;" vertex="1" parent="1"><mxGeometry x="1200.0" y="320.0" width="400.0" height="100.0" as="geometry"/></mxCell><mxCell id="da1r" style="edgeStyle=orthogonalEdgeStyle;fontFamily=Arial;html=0;fontColor=#ececef;strokeWidth=1.5;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=none;labelBackgroundColor=none;fontSize=18;endArrow=block;endFill=1;endSize=8;rounded=0;" edge="1" source="d1" target="d2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3" value="x = f(s) · floor(x / M)&#10;+ q − c(s)" style="rounded=0;whiteSpace=wrap;fillColor=#1f1e24;strokeColor=#b3afb9;fontFamily=Arial;html=0;fontColor=#ececef;strokeWidth=1.5;shadow=0;gradientColor=none;labelBackgroundColor=none;fontSize=18;align=center;verticalAlign=middle;spacing=8;shape=rectangle;perimeter=rectanglePerimeter;" vertex="1" parent="1"><mxGeometry x="1200.0" y="460.0" width="400.0" height="100.0" as="geometry"/></mxCell><mxCell id="da2r" style="edgeStyle=orthogonalEdgeStyle;fontFamily=Arial;html=0;fontColor=#ececef;strokeWidth=1.5;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=none;labelBackgroundColor=none;fontSize=18;endArrow=block;endFill=1;endSize=8;rounded=0;" edge="1" source="d2" target="d3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
