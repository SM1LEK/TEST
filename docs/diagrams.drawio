        </mxCell>
        <mxCell id="n7" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=8;labelBackgroundColor=none;fontColor=#ececef;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=#1f1e24;" value="Взять очередной байт b&#10;Обрабатывать байты в исходном порядке.&#10;index = (crc AND 255) XOR b." vertex="1">
          <mxGeometry height="160" width="460" x="740" y="310" as="geometry"/>
        </mxCell>
        <mxCell id="n8" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=8;labelBackgroundColor=none;fontColor=#ececef;shadow=0;gradientColor=none;strokeColor=#b3afb9;fillColor=#1f1e24;" value="Обновить регистр&#10;crc = (crc &gt;&gt; 8) XOR TABLE[index]." vertex="1">
