  <diagram id="rans-alg" name="rans-alg">
    <mxGraphModel dx="1120" dy="800" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1140" background="#1f1e24">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="rANS • нормализация целочисленных частот" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="24" width="1040" height="52" />
        </mxCell>
        <mxCell id="n-1" value="Частоты v(s); длина n &gt; 0&#10;D = число символов с v(s) &gt; 0" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="110" width="600" height="95" />
        </mxCell>
        <mxCell id="n-2" value="Для каждого присутствующего символа&#10;w(s) = v(s) × (4096 − D)&#10;f⁰(s) = 1 + floor(w(s) / n)&#10;r(s) = w(s) mod n" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="253" width="600" height="148" />
        </mxCell>
        <mxCell id="edge-4" edge="1" parent="1" source="n-1" target="n-2" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n-3" value="Δ = 4096 − Σ f⁰(s)&#10;Сортировать: r по убыванию,&#10;при равенстве — байт по возрастанию" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="449" width="600" height="120" />
        </mxCell>
        <mxCell id="edge-6" edge="1" parent="1" source="n-2" target="n-3" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n-4" value="Добавить 1 первым Δ символам&#10;f(s) ≥ 1; Σ f(s) = 4096" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="617" width="600" height="95" />
        </mxCell>
        <mxCell id="edge-8" edge="1" parent="1" source="n-3" target="n-4" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n-5" value="c(s) = Σ f(t), t &lt; s&#10;Интервал: [c(s), c(s) + f(s))" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="760" width="600" height="100" />
        </mxCell>
        <mxCell id="edge-10" edge="1" parent="1" source="n-4" target="n-5" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n-6" value="Выход: частоты и начала интервалов" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="908" width="600" height="80" />
        </mxCell>
        <mxCell id="edge-12" edge="1" parent="1" source="n-5" target="n-6" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note-12" value="Отсутствующие символы имеют f = 0. При n = 0 весь поток rANS — один байт 00." style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1036" width="1040" height="64" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
