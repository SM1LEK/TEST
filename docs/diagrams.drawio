        <mxCell id="edge-12" edge="1" parent="1" source="n-5" target="n-6" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;dashed=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note-12" value="Четыре байта S и заполнение находятся внутри RS. Таблица CRC32 — снаружи." style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="978" width="1040" height="64" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
