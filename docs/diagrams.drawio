        <mxCell id="title" value="RS(12,10) • декодирование по обнаруженным стираниям" style="text;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
