          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n-3" value="Разбить на D₀ … D₉&#10;10 равных фрагментов по q байт" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
