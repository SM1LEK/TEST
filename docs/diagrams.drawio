        <mxCell id="data" value="S = 6, Y = ASCII ABCDEF; q = 1&#10;D = [6, 0, 0, 0, 65, 66, 67, 68, 69, 70]&#10;P₀ = 189; P₁ = 148" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="130" y="110" width="860" height="130" />
        </mxCell>
        <mxCell id="erase" value="CRC обнаружила повреждение D₀ и D₁&#10;Остальные 10 фрагментов исправны" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="305" width="760" height="100" />
        </mxCell>
        <mxCell id="residual" value="Убрать известные слагаемые из P₀ и P₁&#10;y₀ = 33; y₁ = 83&#10;129D₀ ⊕ 150D₁ = 33&#10;150D₀ ⊕ 129D₁ = 83" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="470" width="760" height="148" />
        </mxCell>
        <mxCell id="inverse" value="A = [129 150; 150 129]&#10;A⁻¹ = [189 219; 219 189]&#10;[D₀; D₁] = A⁻¹ × [33; 83] = [6; 0]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="700" width="760" height="145" />
        </mxCell>
