        <mxCell id="n28" parent="1" value="Кодирование: 0x2C OR 0x80 = 0xAC; затем 0x02&#10;Порядок в потоке: AC 02&#10;Декодирование: (0xAC &amp; 0x7F) + ((0x02 &amp; 0x7F) &lt;&lt; 0x07)&#10;                  = 0x2C + 0x100 = 0x12C" vertex="1" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=left;verticalAlign=top;spacing=0;">
          <mxGeometry x="50" y="380" width="1235" height="127.6" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
