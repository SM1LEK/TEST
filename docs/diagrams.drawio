        <mxCell id="n-1" value="Вход Y; S байт" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="110" width="600" height="80" />
        </mxCell>
        <mxCell id="n-2" value="Добавить S : u32 LE перед Y&#10;q = ceil((S + 4) / 10)&#10;Дополнить нулями до 10q байт" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
