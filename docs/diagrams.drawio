        </mxCell>
        <mxCell id="residual" value="Убрать известные слагаемые из P₀ и P₁&#10;y₀=0x21; y₁=0x53&#10;0x81·D₀ ⊕ 0x96·D₁ = 0x21&#10;0x96·D₀ ⊕ 0x81·D₁ = 0x53" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#ececef;strokeColor=#b3afb9;fillColor=#1f1e24;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;labelBackgroundColor=none;rounded=0;" vertex="1" parent="1">
